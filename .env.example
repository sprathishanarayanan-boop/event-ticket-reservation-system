# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Secret for Authentication (RBAC)
JWT_SECRET=super-secret-jwt-key-event-reservation-2026-tenant-secure
JWT_EXPIRES_IN=24h

# Database Configuration (Leave empty to use built-in SQLite with atomic transactions)
# Or set PostgreSQL connection string for production deployment
# DATABASE_URL=postgresql://user:password@localhost:5432/event_ticket_db
DB_FILE=data/events.db

# Redis Caching (Optional - gracefully falls back to in-memory TTL cache if not provided)
# REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=300

# Reservation Engine Settings
RESERVATION_HOLD_MINUTES=10
CLEANUP_INTERVAL_SECONDS=15

# Payment Simulation
MOCK_PAYMENT_FAILURE_RATE=0.1
