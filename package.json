{
  "name": "multi-tenant-event-ticket-reservation-system",
  "version": "1.0.0",
  "description": "Multi-Tenant Event & Ticket Reservation System with Atomic Concurrency, 10-minute Temporary Holds, Redis Caching, RBAC, and Real-Time Analytics",
  "main": "dist/server/index.js",
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist/server/db', {recursive:true}); fs.copyFileSync('src/server/db/schema.sql', 'dist/server/db/schema.sql');\"",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/server/index.js",
    "seed": "tsx scripts/seed.ts",
    "test:concurrency": "tsx scripts/concurrency-test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
