{
  "info": {
    "_postman_id": "78ab6123-5e91-4cf1-8c42-multitenant-res",
    "name": "Multi-Tenant Event & Ticket Reservation System API",
    "description": "Complete Postman Test Suite covering RBAC (Admin, Organizer, Attendee), Event Management, Redis Caching, Atomic 10-Minute Reservation Holds, Race Condition Stress Tests, and Payment Simulation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('System is healthy', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.status).to.eql('healthy');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Login as Attendee",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('attendeeToken', json.token);",
                  "pm.environment.set('token', json.token);",
                  "pm.environment.set('attendeeUserId', json.user.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"attendee@example.com\",\n  \"password\": \"attendee123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login as Organizer (Apex Tech)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('organizerToken', json.token);",
                  "pm.environment.set('tenantId', json.user.tenantId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"organizer@apextech.com\",\n  \"password\": \"organizer123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.environment.set('adminToken', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eventpass.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Events & Redis Caching",
      "item": [
        {
          "name": "List Active Events (Cached)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var events = pm.response.json();",
                  "pm.expect(events.length).to.be.above(0);",
                  "pm.environment.set('testEventId', events[0].id);",
                  "if (events[0].tiers && events[0].tiers.length > 0) {",
                  "  pm.environment.set('testTierId', events[0].tiers[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"]
            }
          }
        },
        {
          "name": "Get Event By ID (Cached Detail)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/events/{{testEventId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events", "{{testEventId}}"]
            }
          }
        },
        {
          "name": "Create Event (Organizer Role Required)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{organizerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Summit 2026\",\n  \"venue\": \"Developer Center Hall\",\n  \"category\": \"Technology\",\n  \"description\": \"API testing event with automated tickets\",\n  \"start_time\": \"2026-11-15T09:00:00Z\",\n  \"end_time\": \"2026-11-15T18:00:00Z\",\n  \"sales_cutoff\": \"2026-11-14T23:59:59Z\",\n  \"tiers\": [\n    {\n      \"name\": \"VIP Pass\",\n      \"price\": 199.00,\n      \"total_capacity\": 20,\n      \"description\": \"Front Row Access\"\n    },\n    {\n      \"name\": \"Standard Pass\",\n      \"price\": 59.00,\n      \"total_capacity\": 100,\n      \"description\": \"General Entry\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "events"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Reservation Engine (10-Minute Hold)",
      "item": [
        {
          "name": "Create 10-Minute Hold",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.status).to.eql('PENDING');",
                  "pm.expect(json.hold_duration_minutes).to.eql(10);",
                  "pm.environment.set('reservationId', json.reservation_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{testEventId}}\",\n  \"items\": [\n    {\n      \"tier_id\": \"{{testTierId}}\",\n      \"quantity\": 2,\n      \"seat_number\": \"Row-A-Seat-1\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations/hold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reservations", "hold"]
            }
          }
        },
        {
          "name": "Get Hold Status & Expiration Timer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.remaining_seconds).to.be.above(0);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations/{{reservationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reservations", "{{reservationId}}"]
            }
          }
        },
        {
          "name": "Edge Case: Overbooking Attempt (409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 409 Conflict', function () { pm.response.to.have.status(409); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.error).to.include('Seats exhausted');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"{{testEventId}}\",\n  \"items\": [\n    {\n      \"tier_id\": \"{{testTierId}}\",\n      \"quantity\": 999999\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations/hold",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "reservations", "hold"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Mock Payment Simulation & Checkout",
      "item": [
        {
          "name": "Gateway Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "health"]
            }
          }
        },
        {
          "name": "Simulate Payment Checkout (Approved)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.status).to.eql('PAID');",
                  "pm.expect(json.tickets.length).to.be.above(0);",
                  "pm.environment.set('orderId', json.order_id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservation_id\": \"{{reservationId}}\",\n  \"simulate_outcome\": \"APPROVED\",\n  \"payment_method\": \"credit_card\",\n  \"attendees\": [\n    {\n      \"name\": \"Alex Morgan\",\n      \"email\": \"alex@example.com\"\n    },\n    {\n      \"name\": \"Jordan Morgan\",\n      \"email\": \"jordan@example.com\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "checkout"]
            }
          }
        },
        {
          "name": "Edge Case: Re-Checkout Already Paid Hold",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () { pm.response.to.have.status(400); });",
                  "var json = pm.response.json();",
                  "pm.expect(json.error).to.include('already been confirmed and paid');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{attendeeToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reservation_id\": \"{{reservationId}}\",\n  \"simulate_outcome\": \"APPROVED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "checkout"]
            }
          }
        }
      ]
    },
